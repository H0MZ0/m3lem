{
  "name": "m3lem",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "seed:local": "node --env-file=.env.local scripts/seed-local.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postgres": "^3.4.7",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "~5.9.3"
  }
}
